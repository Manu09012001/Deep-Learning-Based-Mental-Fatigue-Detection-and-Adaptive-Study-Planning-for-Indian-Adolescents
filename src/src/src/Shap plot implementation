import numpy as np
import pandas as pd
import matplotlib.pyplot as plt
import xgboost as xgb
import shap

# Set random seed for reproducibility
np.random.seed(42)
n_samples = 1000

# Generating synthetic dataset aligned with Appendix D metadata
X = pd.DataFrame({
    'age': np.random.randint(13, 20, size=n_samples),
    'study_hours_per_day': np.random.normal(3.5, 1.5, n_samples).clip(0, 9),
    'sleep_hours': np.random.normal(6.5, 1.2, n_samples).clip(3, 10),
    'social_media_hours': np.random.gamma(shape=3, scale=0.8, size=n_samples).clip(0, 8),
    'netflix_hours': np.random.exponential(scale=1.2, size=n_samples).clip(0, 6),
    'attendance_percentage': np.random.uniform(60, 100, n_samples),
    'exercise_frequency': np.random.poisson(lam=2, size=n_samples),
    'mental_health_rating': np.random.randint(1, 10, size=n_samples)
})

# Add Exam Score
X['exam_score'] = (X['study_hours_per_day'] * 8.5 + np.random.normal(40, 8, n_samples)).clip(20, 100)

# Target variable formulation (0: Low, 1: Moderate, 2: High Fatigue)
fatigue_score = (X['study_hours_per_day'] * 0.4 + X['social_media_hours'] * 0.3 - X['sleep_hours'] * 0.5)
y = pd.qcut(fatigue_score, q=3, labels=[0, 1, 2]).astype(int)

# Train XGBoost Classifier
model = xgb.XGBClassifier(n_estimators=100, max_depth=4, random_state=42)
model.fit(X, y)

# Compute SHAP Values
explainer = shap.TreeExplainer(model)
shap_values = explainer(X)

# ==========================================
# Final Thesis Plot: SHAP Beeswarm Summary Plot
# ==========================================
plt.figure(figsize=(9, 6))
plt.title('SHAP Summary Plot for High Fatigue Prediction', fontweight='bold', pad=12)

# Display SHAP summary plot for High Fatigue Class (Index 2)
shap.summary_plot(shap_values[:, :, 2], X, max_display=10, show=False)

plt.tight_layout()
plt.show()
